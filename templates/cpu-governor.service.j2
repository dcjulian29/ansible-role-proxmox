{{ ansible_managed | comment }}
[Unit]
Description=Set the CPU scaling governor
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/bin/sh -c 'for c in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo {{ proxmox_cpu_governor }} > "$c"; done'

[Install]
WantedBy=multi-user.target
